---
import Button from "../../../components/Button.astro";
import Pagination from "../_components/Pagination.astro";
import WorksGrid from "../_components/WorksGrid.astro";
import WorksLayout from "../_components/WorksLayout.astro";
import { games } from "../games.ts";

import type { PaginateFunction } from "astro";

export const getStaticPaths = ({ paginate }: { paginate: PaginateFunction }) => {
  const uniqueYears = [...new Set(games.map((game) => game.year).filter((year): year is number => year !== null))];

  return uniqueYears.flatMap((year) => {
    const filteredGames = games.filter((game) => game.year === year);
    return paginate(filteredGames, {
      params: { year: year.toString() },
      pageSize: 8,
    });
  });
};

const { year } = Astro.params;
const { page } = Astro.props;
---

<WorksLayout title={`${year}年 作品一覧`} description={`${year}年にCCSで制作された作品の一覧です。`}>
  <WorksGrid games={page.data} isDisplayYear={false} />
  <Pagination page={page} />
  <Button
    href="/works"
    class="mx-auto bg-orange-500 px-8 py-4 text-base text-white shadow-md shadow-orange-500 hover:bg-orange-600 focus-visible:ring-orange-500"
  >
    作品一覧に戻る
  </Button>
</WorksLayout>
