---
import NextPrevButton from "./_components/NextPrevButton.astro";
import WorksGrid from "./_components/WorksGrid.astro";
import WorksLayout from "./_components/WorksLayout.astro";
import { games } from "./_components/games.ts";

import type { PaginateFunction } from "astro";

const uniqueYears = [...new Set(games.map((game) => game.year).filter((year): year is number => year !== null))];
const sortedUniqueYears = uniqueYears.sort((a, b) => b - a);

const nullYearsCount = [...new Set(games.filter((game) => game.year === null))].length;

export function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  return paginate(games, { pageSize: 8 });
}

const { page } = Astro.props;
---

<WorksLayout title="作品一覧">
  <div class="my-6 grid grid-cols-[repeat(auto-fit,85px)] justify-center gap-2">
    {
      sortedUniqueYears.map((year) => (
        <a
          href={`/works/${year}`}
          class="flex w-full items-center justify-center rounded-full bg-violet-600 py-2 text-base text-white shadow-md hover:bg-violet-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-600 focus-visible:ring-offset-2"
        >
          {year}年
        </a>
      ))
    }
    {
      nullYearsCount > 0 && (
        <a
          href={`/works/others`}
          class="flex w-full items-center justify-center rounded-full bg-violet-600 py-2 text-base text-white shadow-md hover:bg-violet-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-600 focus-visible:ring-offset-2"
        >
          その他
        </a>
      )
    }
  </div>
  <WorksGrid games={page.data} isDisplayYear={true} />
  <NextPrevButton page={page} />
</WorksLayout>
