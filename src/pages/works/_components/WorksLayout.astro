---
import Layout from "../../../layouts/Layout.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description} class="container m-auto px-6 md:w-[80%]">
  <h1 class="mt-4 text-2xl font-bold md:mt-8 md:text-3xl">{title}</h1>
  <slot />
</Layout>
