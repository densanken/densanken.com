---
import Layout from "../../../layouts/Layout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Layout title={title}>
  <section class="container m-auto px-6 md:w-[80%]">
    <h1 class="mt-4 text-2xl font-bold md:text-3xl">{title}</h1>
    <slot />
  </section>
</Layout>
