---
interface Props {
  direction: "prev" | "next";
  double?: boolean;
  label?: string;
}

const { direction, double = false, label } = Astro.props;
const chevronPath =
  direction === "prev"
    ? "M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z"
    : "M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z";

const pathTransforms = double
  ? direction === "prev"
    ? ["translate(-2 0)", "translate(3 0)"]
    : ["translate(-3 0)", "translate(2 0)"]
  : [undefined];
---

{label && <span class="sr-only">{label}</span>}
<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
  {pathTransforms.map((pathTransform) => <path d={chevronPath} transform={pathTransform} />)}
</svg>
